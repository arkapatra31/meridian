# ── Anthropic API ─────────────────────────────────────────────────────────────
# Required. Used by C4b (surgical agent) and C6 (QnA agent).
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── AWS Bedrock (optional) ────────────────────────────────────────────────────
# Set CLAUDE_CODE_USE_BEDROCK=1 to route LLM calls through Bedrock instead of
# the Anthropic API. Requires AWS credentials with Bedrock model access.
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── Security ──────────────────────────────────────────────────────────────────
# MUST be changed in production. Used to sign and verify JWTs (HS256).
JWT_SECRET=change-me-in-production

# ── Server ────────────────────────────────────────────────────────────────────
# MERIDIAN_HOST is forced to 0.0.0.0 inside the container (set in Dockerfile).
# MERIDIAN_HOST=0.0.0.0
MERIDIAN_PORT=8000
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for development only.
# In production set this to the exact frontend origin, e.g. https://your-domain.com
MERIDIAN_CORS_ORIGINS=*

# ── QnA tuning ────────────────────────────────────────────────────────────────
# Number of seed nodes retrieved per QnA turn (C6 search_nodes).
QNA_TOP_K=6
# Maximum conversation turns before the session is closed.
QNA_MAX_TURNS=8

# ── GitHub MCP (optional) ─────────────────────────────────────────────────────
# Used by C3b for commit-log enrichment in PATCH builds. Failures degrade
# silently — the build succeeds without enrichment if this is unreachable.
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
